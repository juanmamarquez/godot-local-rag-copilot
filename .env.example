# Godot Local RAG Agent settings

# Absolute path to the Godot project you want to vectorize
GODOT_PROJECT_PATH=/absolute/path/to/your/godot-project

# Ollama host address, e.g. http://localhost:11434
OLLAMA_HOST=http://your-ollama-host:11434

# Set to true to skip local project retrieval (useful when the client supplies code context)
DISABLE_LOCAL_RAG_ROUTING=false

# CORS is opt-in. VSCode / Continue.dev calls the API from the extension host, not from
# a browser page, so it doesn't need it. Enable it only for browser-based
# clients, listing their origins explicitly, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=